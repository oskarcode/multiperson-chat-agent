{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multiperson-chat-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ChatRoom"
      },
      {
        "name": "ADMIN",
        "class_name": "DemoAdmin"
      }
    ]
  },
  "exports": {
    "MultiPersonChat": {
      "type": "durable-object",
      "state": "deleted"
    },
    "PiSession": {
      "type": "durable-object",
      "state": "deleted"
    },
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DemoAdmin": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "AI_MODEL": "@cf/zai-org/glm-5.3",
    "AI_GATEWAY_ID": "",
    "MCP_URL": ""
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
