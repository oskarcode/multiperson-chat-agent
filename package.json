{
  "name": "multiperson-chat-agent",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false --no-strict-vars --env-interface WorkerEnv",
    "types:check": "wrangler types worker-configuration.d.ts --include-runtime=false --no-strict-vars --env-interface WorkerEnv --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "check": "pnpm types:check && pnpm typecheck && pnpm test && wrangler deploy --dry-run --outdir .wrangler/dry-run && node --test scripts/test-worker.mjs scripts/test-deploy.mjs",
    "test:browser": "pnpm check && node scripts/test-browser.mjs",
    "deploy:agent": "node scripts/deploy-agent.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "1.58.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.42.0"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "agents": "0.28.1"
  }
}
