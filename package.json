{
  "name": "multiperson-chat-agent",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "check": "pnpm typecheck && pnpm test && wrangler deploy --dry-run --outdir .wrangler/dry-run && node --test scripts/test-onboarding.mjs scripts/test-deploy.mjs",
    "test:browser": "pnpm check && node scripts/test-browser.mjs",
    "deploy:agent": "node scripts/deploy-agent.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "1.58.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.42.0"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "hono": "^4.13.16"
  }
}
